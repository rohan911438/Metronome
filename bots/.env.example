# Copy to bots/.env. Never commit bots/.env.
NETWORK=testnet                # local | testnet | mainnet
# RPC_URL=                     # defaults to the chain's public RPC
# POLL_MS=400                  # block polling; Monad blocks are ~0.3 s
# LOG_CHUNK=100                # max blocks per eth_getLogs call

# Keys. If unset, both fall back to PRIVATE_KEY in contracts/.env (the deployer).
KEEPER_PRIVATE_KEY=
MM_PRIVATE_KEY=

# Market maker
# MM_LEVELS=5                  # orders per side
# MM_FIRST_TICKS=2             # best bid/ask distance from the reference (1 tick = 10 bps)
# MM_STEP_TICKS=2              # distance between levels
# MM_SIZE=50000000000000000000 # base units per order (50 MON)
# MM_REQUOTE_TICKS=3           # re-quote when the reference moves this far
# START_TICK=2048              # reference before the first trade (2048 = 0.025 AUSD on testnet)
